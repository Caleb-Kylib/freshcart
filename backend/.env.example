PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret

# Daraja sandbox application credentials from developer.safaricom.co.ke
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_sandbox_consumer_key
MPESA_CONSUMER_SECRET=your_sandbox_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_sandbox_lipa_na_mpesa_passkey
# This must be a publicly reachable HTTPS URL; localhost will not receive Safaricom callbacks.
MPESA_CALLBACK_URL=https://your-public-domain.example/api/orders/daraja/callback
# CustomerPayBillOnline for PayBill; use CustomerBuyGoodsOnline only for a Till setup.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
